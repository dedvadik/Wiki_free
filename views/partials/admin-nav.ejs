<%#
  partials/admin-nav.ejs — вкладки раздела администрирования.
  Активная вкладка определяется по текущему адресу (currentPath).
%>
<nav class="tabs" aria-label="Разделы администрирования">
  <a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>">Обзор</a>
  <a href="/admin/settings" class="<%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>">Настройки</a>
  <a href="/admin/ldap" class="<%= currentPath.startsWith('/admin/ldap') ? 'active' : '' %>">LDAP<% if (site.ldap_enabled) { %> <span class="badge">вкл</span><% } %></a>
  <a href="/admin/users" class="<%= currentPath.startsWith('/admin/users') ? 'active' : '' %>">Пользователи</a>
</nav>
