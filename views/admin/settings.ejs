<%#
  ============================================================================
  admin/settings.ejs — раздел настроек сайта (Общие / Доступ / Оформление)
  ----------------------------------------------------------------------------
  Один шаблон на все разделы: поля раздела строятся АВТОМАТИЧЕСКИ по схеме
  SETTINGS_SCHEMA (src/services/settings.js, свойство tab) — их выводит
  partials/settings-groups. Форма сохраняет только поля этого раздела.
  Цветовые пресеты — кнопки с data-preset; public/js/admin.js по клику
  подставляет значения в поля формы.

  Переменные: section, meta { title, description }, groups, values, presets,
              themes, errors
  ============================================================================
%>
<%- include('/partials/header', { title: meta.title }) %>

<div class="settings-shell">
  <%- include('/partials/settings-nav', { area: 'admin', active: section }) %>

  <section class="settings-main">
    <header class="settings-header">
      <h1><%= meta.title %></h1>
      <p><%= meta.description %></p>
    </header>

    <%- include('/partials/errors') %>

    <form method="post" action="/admin/settings/<%= section %>" class="form settings-form" id="settings-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">

      <%- include('/partials/settings-groups', { groups, values, presets, themes }) %>

      <div class="form-actions sticky-actions">
        <button class="btn btn-primary" type="submit">Сохранить</button>
        <span class="muted small">Изменения применяются сразу для всех пользователей.</span>
      </div>
    </form>

    <%# Скрытые формы сброса групп (кнопки — внутри partials/settings-groups). %>
    <% groups.forEach((group, gi) => { %>
      <form id="reset-<%= gi %>" method="post" action="/admin/settings/reset" hidden
            data-confirm="Сбросить все настройки группы «<%= group.name %>» к значениям по умолчанию?">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <input type="hidden" name="group" value="<%= group.name %>">
      </form>
    <% }) %>
  </section>
</div>

<%- include('/partials/footer', { scripts: ['/js/admin.js'] }) %>
