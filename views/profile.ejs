<%#
  ============================================================================
  profile.ejs — профиль пользователя (только информация)
  ----------------------------------------------------------------------------
  Визитка: обложка с градиентом, крупный аватар, имя, логин, роль;
  плитки статистики; сведения об учётной записи; недавние правки и
  избранное. Всё, что можно изменить, — в разделе «Настройки» (/settings).
  Цвет аватара вычисляется из имени (avatarHue), поэтому у каждого свой.
  Переменные: details { created_at, last_login_at, ldap_dn },
              stats { pages, edits, comments, favorites }, edits, favorites
  ============================================================================
%>
<% const isLdap = currentUser.auth_source === 'ldap';
   const hue = avatarHue(currentUser.display_name); %>
<%- include('/partials/header', { title: 'Профиль' }) %>

<div class="profile-page">
  <%# ---------------------------- Визитка -------------------------------- %>
  <section class="card profile-hero" style="--avatar-h: <%= hue %>">
    <div class="profile-cover" aria-hidden="true"></div>
    <div class="profile-hero-body">
      <span class="avatar avatar-xl"><%= initials(currentUser.display_name) %></span>
      <div class="profile-identity">
        <h1><%= currentUser.display_name %></h1>
        <div class="profile-tags">
          <span class="muted">@<%= currentUser.username %></span>
          <span class="role role-<%= currentUser.role %>"><%= roleNames[currentUser.role] %></span>
          <% if (isLdap) { %><span class="badge">LDAP</span><% } %>
        </div>
      </div>
      <div class="profile-actions">
        <a class="btn" href="/settings"><%- icon('settings') %> Настройки</a>
      </div>
    </div>
  </section>

  <%# ------------------------- Статистика -------------------------------- %>
  <div class="profile-stats">
    <%# Подписи — неизменяемые фразы («Создано страниц»), поэтому их не нужно
        склонять под число. %>
    <% [
         ['file-text', '#007aff', stats.pages, 'Создано страниц'],
         ['edit', '#ff9500', stats.edits, 'Правок'],
         ['message', '#34c759', stats.comments, 'Комментариев'],
         ['star', '#ffcc00', stats.favorites, 'В избранном'],
       ].forEach(([iconName, tile, value, label]) => { %>
      <div class="card profile-stat">
        <span class="settings-tile" style="--tile: <%= tile %>"><%- icon(iconName) %></span>
        <div>
          <div class="profile-stat-value"><%= value %></div>
          <div class="profile-stat-label muted"><%= label %></div>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="profile-columns">
    <%# ---------------------- Сведения об учётной записи ------------------ %>
    <div class="card">
      <h2 class="card-title">Сведения</h2>
      <dl class="settings-list">
        <div><dt><%- icon('mail') %> Email</dt><dd><%= currentUser.email %></dd></div>
        <div><dt><%- icon('calendar') %> С нами с</dt><dd><%= formatDate(details.created_at) %></dd></div>
        <div><dt><%- icon('clock') %> Последний вход</dt><dd><%= details.last_login_at ? timeAgo(details.last_login_at) : 'сейчас' %></dd></div>
        <div><dt><%- icon('key') %> Вход</dt><dd><%= isLdap ? 'Корпоративная учётная запись (LDAP)' : 'Логин и пароль' %></dd></div>
      </dl>
      <% if (isLdap && details.ldap_dn) { %><p class="settings-card-note"><code class="ldap-dn"><%= details.ldap_dn %></code></p><% } %>
    </div>

    <%# -------------------------- Недавние правки ------------------------- %>
    <div class="card">
      <h2 class="card-title">Недавние правки</h2>
      <% if (!edits.length) { %>
        <p class="muted">Вы ещё не редактировали страницы.</p>
      <% } else { %>
        <ul class="list">
          <% edits.forEach((e) => { %>
            <li class="list-item">
              <span class="list-icon"><%= e.space_icon %></span>
              <div class="list-body">
                <a class="list-title" href="<%= pageUrl(e) %>"><%= e.title %></a>
                <div class="list-meta"><%= e.space_name %> · версия <%= e.version %> · <%= timeAgo(e.created_at) %></div>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <%# ------------------------------ Избранное ---------------------------- %>
    <div class="card">
      <h2 class="card-title">Избранное</h2>
      <% if (!favorites.length) { %>
        <p class="muted">Нажмите «☆ В избранное» на любой странице, чтобы она появилась здесь.</p>
      <% } else { %>
        <ul class="list">
          <% favorites.forEach((f) => { %>
            <li class="list-item">
              <span class="list-icon"><%= f.space_icon %></span>
              <div class="list-body">
                <a class="list-title" href="<%= pageUrl(f) %>"><%= f.title %></a>
                <div class="list-meta"><%= f.space_name %></div>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>
</div>

<%- include('/partials/footer') %>
