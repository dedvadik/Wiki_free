# =============================================================================
#  .env.example — образец файла настроек развёртывания
#  Скопируйте в .env и измените значения:   cp .env.example .env
#  Файл .env читается docker compose автоматически. НЕ публикуйте его:
#  в нём пароли (.env уже добавлен в .gitignore).
# =============================================================================

# --- Сеть --------------------------------------------------------------------
# Порт на хост-машине, на котором будет доступен сайт: http://localhost:8080
APP_PORT=8080

# --- База данных -------------------------------------------------------------
POSTGRES_DB=wiki
POSTGRES_USER=wiki
# ОБЯЗАТЕЛЬНО смените пароль до первого запуска! (после первого запуска
# пароль уже записан в volume БД; чтобы сменить его позже, используйте
# ALTER USER внутри PostgreSQL).
POSTGRES_PASSWORD=change_me_db_password

# --- Первый администратор ----------------------------------------------------
# Создаётся при первом запуске, если в базе нет пользователей.
# Если оставить ADMIN_PASSWORD пустым — администратором станет первый,
# кто зарегистрируется на сайте.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# --- Безопасность ------------------------------------------------------------
# Секрет подписи cookie (длинная случайная строка, например: openssl rand -hex 32).
# Пусто — будет сгенерирован автоматически и сохранён в volume app-data.
SESSION_SECRET=
# true — cookie только по HTTPS. Включайте, если сайт работает за HTTPS-прокси.
COOKIE_SECURE=false
# Если перед приложением стоит обратный прокси (nginx, Traefik, Caddy) —
# укажите количество прокси (обычно 1), чтобы корректно определялся IP клиента.
TRUST_PROXY=false

# --- Прочее ------------------------------------------------------------------
# Создать демо-пространство с документацией при первом запуске.
SEED_DEMO=true
# Максимальный размер загружаемого файла, МБ.
UPLOAD_MAX_MB=20
# Часовой пояс для отображения дат.
TZ=Europe/Moscow
# Версия Node.js для сборки образа.
NODE_VERSION=22
# Имя собранного образа (например, для публикации в реестр).
APP_IMAGE=wikispace:latest
# Попыток входа/регистрации с одного IP за 15 минут (защита от перебора).
AUTH_RATE_LIMIT=20

# --- Вход через LDAP / Active Directory --------------------------------------
# Всё это можно настроить и в админке (Администрирование → LDAP) — там же
# есть кнопка «Проверить». Значения из админки имеют приоритет над этими.
# Пустое значение = «не задано» (действует значение по умолчанию).
#
# SETTING_LDAP_ENABLED=true
# SETTING_LDAP_URL=ldaps://dc01.corp.example.com:636
# SETTING_LDAP_STARTTLS=false
# SETTING_LDAP_TLS_VERIFY=true
# SETTING_LDAP_BIND_DN=wiki-svc@corp.example.com
# SETTING_LDAP_BIND_PASSWORD=
# SETTING_LDAP_SEARCH_BASE=ou=Users,dc=corp,dc=example,dc=com
# SETTING_LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={{username}}))
# SETTING_LDAP_ATTR_USERNAME=sAMAccountName
# SETTING_LDAP_ATTR_EMAIL=mail
# SETTING_LDAP_ATTR_DISPLAY_NAME=displayName
# SETTING_LDAP_ADMIN_GROUP=CN=Wiki Admins,OU=Groups,DC=corp,DC=example,DC=com
# SETTING_LDAP_EDITOR_GROUP=CN=Wiki Editors,OU=Groups,DC=corp,DC=example,DC=com
# SETTING_LDAP_DEFAULT_ROLE=viewer
# SETTING_LDAP_ALLOW_LOCAL=true
