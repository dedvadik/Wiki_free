<%#
  ============================================================================
  admin/users.ejs — «Администрирование → Пользователи»
  ----------------------------------------------------------------------------
  Список пользователей строками (аватар, имя, логин, роль, статус,
  последний вход); вся строка — ссылка на карточку пользователя, где
  меняют роль, блокируют, сбрасывают пароль и удаляют.
  Ниже — форма добавления пользователя (актуально при закрытой регистрации).
  Переменные: users, roles, values (данные формы при ошибке), errors
  ============================================================================
%>
<%- include('/partials/header', { title: 'Пользователи' }) %>

<div class="settings-shell">
  <%- include('/partials/settings-nav', { area: 'admin', active: 'users' }) %>

  <section class="settings-main">
    <header class="settings-header">
      <h1>Пользователи</h1>
      <p><%= plural(users.length, 'учётная запись', 'учётные записи', 'учётных записей') %>. Нажмите на пользователя, чтобы изменить роль, заблокировать или удалить.</p>
    </header>

    <div class="card settings-card">
      <div class="settings-links">
        <% users.forEach((u) => { %>
          <a class="settings-row settings-row-link <%= u.is_active ? '' : 'row-disabled' %>" href="/admin/users/<%= u.id %>">
            <span class="avatar avatar-md" style="--avatar-h: <%= avatarHue(u.display_name) %>"><%= initials(u.display_name) %></span>
            <span class="grow user-row-main">
              <strong><%= u.display_name %></strong>
              <span class="muted small">@<%= u.username %> · <%= u.email %></span>
            </span>
            <span class="user-row-meta">
              <span class="role role-<%= u.role %>"><%= roleNames[u.role] %></span>
              <% if (u.auth_source === 'ldap') { %><span class="badge" title="Учётная запись из каталога LDAP">LDAP</span><% } %>
              <% if (!u.is_active) { %><span class="badge badge-danger">заблокирован</span><% } %>
            </span>
            <span class="muted small nowrap user-row-seen" title="Последний вход">
              <%= u.last_login_at ? timeAgo(u.last_login_at) : 'не входил' %> · <%= plural(u.edits, 'правка', 'правки', 'правок') %>
            </span>
            <%- icon('chevron-right', 'muted') %>
          </a>
        <% }) %>
      </div>
    </div>

    <%- include('/partials/errors') %>
    <form method="post" action="/admin/users" class="form card settings-card">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <h2 class="settings-card-title">Добавить пользователя</h2>
      <div class="field-row">
        <div class="field grow"><label for="nu-name">Имя</label>
          <input id="nu-name" name="display_name" value="<%= values.displayName || '' %>" required maxlength="100"></div>
        <div class="field grow"><label for="nu-login">Логин</label>
          <input id="nu-login" name="username" value="<%= values.username || '' %>" required pattern="[a-zA-Z0-9_.\-]{3,50}"></div>
      </div>
      <div class="field-row">
        <div class="field grow"><label for="nu-email">Email</label>
          <input id="nu-email" type="email" name="email" value="<%= values.email || '' %>" required></div>
        <div class="field grow"><label for="nu-pass">Пароль</label>
          <input id="nu-pass" type="password" name="password" required minlength="8" autocomplete="new-password"></div>
        <div class="field"><label for="nu-role">Роль</label>
          <select id="nu-role" name="role">
            <% roles.forEach((r) => { %><option value="<%= r %>" <%= (values.role || 'editor') === r ? 'selected' : '' %>><%= roleNames[r] %></option><% }) %>
          </select></div>
      </div>
      <div class="settings-card-actions">
        <button class="btn btn-primary" type="submit">Создать пользователя</button>
      </div>
    </form>
  </section>
</div>

<%- include('/partials/footer') %>
